<odoo>
    <!-- AUTHOR VIEWS -->
    <record id="view_library_author_list" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list string="Author Detail">
                <field name="name"/>
                <field name="total_books"/>
            </list>
        </field>
    </record>

    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author Form">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_author_root" name="Library Author" sequence="10"/>
    <menuitem id="menu_authors" name="Authors" parent="menu_library_author_root" action="action_library_author" sequence="10"/>

    <!-- BOOK VIEWS -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Book Detail">
                <field name="title"/>
                <field name="author_id"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book Form">
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="author_id"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_book_root" name="Library Book" sequence="10"/>
    <menuitem id="menu_books" name="Books" parent="menu_library_book_root" action="action_library_book" sequence="10"/>

    <!-- BOOK CATEGORIED VIEWS -->
    <data>
        <record id="view_library_book_list_inherit" model="ir.ui.view">
            <field name="name">library.book.list.inherit</field>
            <field name="model">library.book</field>
            <field name="inherit_id" ref="test_odoo.view_library_book_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price']" position="after">
                    <field name="category"/>
                    <!-- <field name="total_books_in_category"/> -->
                </xpath>
            </field>
        </record>
    </data>

    <data>
        <record id="view_library_book_form_inherit" model="ir.ui.view">
            <field name="name">library.book.form.inherit</field>
            <field name="model">library.book</field>
            <field name="inherit_id" ref="test_odoo.view_library_book_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <button name="compute_total_in_category" class="oe_stat_button" icon="fa-book" type="object">
                        <field name="total_books_in_category" widget="statinfo" string=" Total Books in This Category"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='price']" position="after">
                    <field name="category"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>